+
+// Keep D exceptions inside the DLL ABI; the Swift caller can report load failure.
+public export extern(C) int xadi_LoadChecked(const char* path) {
+    try {
+        xadi_Load(path);
+        return 0;
+    } catch (Throwable error) {
+        return -1000001;
+    }
+}
