+// Swift and the public signer API use UTF-8 regardless of the host's ACP.
+inline std::wstring ZWinWide(const char* text) {
+    if (!text || !*text) return {};
+    int count = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, NULL, 0);
+    if (!count) return {};
+    std::wstring wide((size_t)count, L'\0');
+    if (!MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, &wide[0], count)) return {};
+    wide.resize((size_t)count - 1);
+    return wide;
+}
+inline std::string ZWinUTF8(const wchar_t* text) {
+    if (!text || !*text) return {};
+    int count = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, text, -1, NULL, 0, NULL, NULL);
+    if (!count) return {};
+    std::string utf8((size_t)count, '\0');
+    if (!WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, text, -1, &utf8[0], count, NULL, NULL)) return {};
+    utf8.resize((size_t)count - 1);
+    return utf8;
+}
+inline std::wstring ZWinAbsolutePath(const char* text) {
+    std::wstring path = ZWinWide(text);
+    for (auto& character : path) if (character == L'/') character = L'\\';
+    if (path.empty() || path.compare(0, 4, L"\\\\?\\") == 0) return path;
+    DWORD count = GetFullPathNameW(path.c_str(), 0, NULL, NULL);
+    if (!count) return {};
+    std::wstring absolute(count, L'\0');
+    DWORD written = GetFullPathNameW(path.c_str(), count, &absolute[0], NULL);
+    if (!written || written >= count) return {};
+    absolute.resize(written);
+    return absolute;
+}
+inline std::wstring ZWinPath(const char* text) {
+    auto path = ZWinAbsolutePath(text);
+    if (path.empty() || path.compare(0, 4, L"\\\\?\\") == 0) return path;
+    return path.compare(0, 2, L"\\\\") == 0 ? L"\\\\?\\UNC\\" + path.substr(2) : L"\\\\?\\" + path;
+}
+inline int ZWinFOpen(FILE** file, const char* path, const char* mode) {
+    return _wfopen_s(file, ZWinPath(path).c_str(), ZWinWide(mode).c_str());
+}
+#include "iconv.h"
+
+
+#define PATH_MAX					4096
+
+#define _fopen64(fp, path, mode)	{ ZWinFOpen(&fp, path, mode); }
